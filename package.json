{
  "name": "cmil",
  "version": "0.23.0-alpha.0",
  "description": "Multilanguage programming platform especially for kids",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./convert": {
      "types": "./dist/convert/index.d.ts",
      "default": "./dist/convert/index.js"
    },
    "./convert/core": {
      "types": "./dist/convert/core.d.ts",
      "default": "./dist/convert/core.js"
    },
    "./convert/*": {
      "types": "./dist/convert/writers/*.d.ts",
      "default": "./dist/convert/writers/*.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror/index.d.ts",
      "default": "./dist/codemirror/index.js"
    },
    "./codemirror/targets": {
      "types": "./dist/codemirror/targets/index.d.ts",
      "default": "./dist/codemirror/targets/index.js"
    },
    "./codemirror/targets/core": {
      "types": "./dist/codemirror/targets/core.d.ts",
      "default": "./dist/codemirror/targets/core.js"
    },
    "./codemirror/targets/*": {
      "types": "./dist/codemirror/targets/writers/*.d.ts",
      "default": "./dist/codemirror/targets/writers/*.js"
    }
  },
  "sideEffects": [
    "./dist/convert/writers/*.js",
    "./dist/codemirror/targets/writers/*.js"
  ],
  "files": [
    "dist",
    "src/constants/LICENSE",
    "src/translations/LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc",
    "test": "node --test --test-timeout=5000 \"test/*.ts\"",
    "coverage": "c8 --reporter=text --reporter=html npm test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "translations-table": "node scripts/translations-table.ts",
    "snapshot": "node scripts/snapshot.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinguaCode/cmil.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "author": "Arman Yeghiazaryan <otanim617@gmail.com> (https://otanim.com)",
  "license": "GPL-3.0-only",
  "bugs": "https://github.com/LinguaCode/cmil/issues",
  "peerDependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/lang-cpp": "^6",
    "@codemirror/lang-go": "^6",
    "@codemirror/lang-java": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-php": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/lang-cpp": {
      "optional": true
    },
    "@codemirror/lang-go": {
      "optional": true
    },
    "@codemirror/lang-java": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/lang-php": {
      "optional": true
    },
    "@codemirror/lang-python": {
      "optional": true
    },
    "@codemirror/lang-rust": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/legacy-modes": {
      "optional": true
    },
    "@codemirror/lint": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.19.0",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
