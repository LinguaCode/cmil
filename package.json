{
  "name": "cmil",
  "version": "0.4.0-alpha.2",
  "description": "Multilanguage programming platform especially for kids",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc",
    "test": "node --test --test-timeout=5000 \"test/*.ts\"",
    "coverage": "c8 --reporter=text --reporter=html npm test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinguaCode/cmil.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "author": "Arman Yeghiazaryann <otanim617@gmail.com> (http://otanim.com)",
  "license": "SEE LICENSE IN LICENSE file",
  "bugs": "https://github.com/LinguaCode/cmil/issues",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
